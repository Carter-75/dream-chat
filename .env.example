# Dream Chat environment (copy to .env.local for local dev, set real values in Vercel)
PROJECT_NAME=dream-chat
PORT=3000
FRONTEND_PORT=4200
PRODUCTION=false

# Accounts and saved conversations use MongoDB (database name comes
# from PROJECT_NAME in backend/app.js). Without a URI the site still
# works for guests; sign in and saved history stay switched off.
MONGODB_URI=

# Session signing secret for account cookies. Use a long random string.
JWT_SECRET=

# Google sign in: OAuth client ID from Google Cloud Console (public value).
GOOGLE_CLIENT_ID=

# OpenAI (backend only, never put a key in frontend code)
OPENAI_API_KEY=
# Cheapest chat model found at build time (Oct 21, 2026): gpt-5-nano
# $0.05 per 1M input tokens, $0.40 per 1M output tokens.
# To upgrade answer quality later, set this to gpt-5-mini and redeploy.
OPENAI_MODEL=gpt-5-nano

# Abuse protection (in-memory, per visitor IP)
CHAT_PER_MINUTE=10
CHAT_DAILY_CAP_PER_IP=50
CHAT_GLOBAL_DAILY_CAP=500
